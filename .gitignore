# Documentation archives are local-only scratch/history.
docs/legacy/
docs/legacy/**

# -----------------------------------------------------------------------------
# Copie residue da merge/rebase o editor (mai committare — es. `.agent~HEAD`, `*.md~head`)
# -----------------------------------------------------------------------------
*~HEAD
*~BASE
*~LOCAL
*~REMOTE
*.orig
*.rej
*~head

# Backup locali (script conflitti / editor — mai committare)
*.bak
*.backup
*.backup.*
*.backup-*
*.backup_*
.cursor/
.devcontainer/
.vscode/
.windsurf/

# Local vector DB (agent tooling)
ruvector.db

# PHPStan output files
phpstan*

# Prevent docs/archive dirs
docs/archive

# Output strumenti AI (cache locali, mai in git)
graphify-out/
.headroom/

